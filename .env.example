# LLM provider: mock | ollama | api
#   mock   — deterministic, no GPU / no API key (default for demos)
#   ollama — local Ollama at OLLAMA_BASE_URL
#   api    — OpenAI-compatible chat completions (paste API_KEY below)
LLM_PROVIDER=mock

# --- Ollama (LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_MODEL_FAST=llama3.2:1b

# --- OpenAI-compatible API (LLM_PROVIDER=api) ---
# Paste your key here (never commit .env). Works with OpenAI, Cursor, and other
# OpenAI-compatible bases that expose POST {API_BASE_URL}/chat/completions.
API_KEY=
# Default OpenAI; override for Cursor/other gateways, e.g. https://api.openai.com/v1
API_BASE_URL=https://api.openai.com/v1
API_MODEL=gpt-4o-mini
API_MODEL_FAST=gpt-4o-mini

# Cost estimate ($ per 1K tokens) — used for metrics even with mock/ollama
USD_PER_1K_INPUT=0.0001
USD_PER_1K_OUTPUT=0.0002

# SLO budgets (ms)
FAST_LATENCY_BUDGET_MS=8000
THOROUGH_LATENCY_BUDGET_MS=30000

# Local SQLite paths (under data/)
METRICS_DB_PATH=data/metrics.db
RAG_DB_PATH=data/rag.db

# Server
HOST=0.0.0.0
PORT=43125
